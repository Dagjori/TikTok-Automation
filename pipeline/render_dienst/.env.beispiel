# Vorlage für pipeline/render_dienst/.env  (die echte .env NIE committen, sie steht in .gitignore)
# Kopieren:  copy .env.beispiel .env   und dann mit dem Editor die Werte eintragen. Keine Anführungszeichen nötig.

# Supabase: Project URL (Dashboard -> Project Settings -> Data API -> Project URL)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Supabase: geheimer Schlüssel (Dashboard -> Project Settings -> API Keys -> "Secret key" bzw. Legacy "service_role")
SUPABASE_KEY=HIER-DEN-GEHEIMEN-SCHLUESSEL-EINTRAGEN

# Optional (nur ändern, wenn Claude es sagt):
# SUPABASE_BUCKET=buffer-uploads
# SUPABASE_AUTH=keine
# RECHNERNAME=Render-PC
# BASH_PFAD=C:\Program Files\Git\bin\bash.exe
